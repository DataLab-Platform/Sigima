msgid "qtpy"
msgstr "qtpy"

msgid "Provides an abstraction layer on top of the various Qt bindings (PyQt5/6 and PySide2/6)."
msgstr "Fournit une couche d'abstraction au-dessus des différentes liaisons Qt (PyQt5/6 et PySide2/6)."

